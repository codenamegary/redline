{
  "name": "redline",
  "version": "0.5.0",
  "description": "Local review server for AI-generated design artifacts. The agent renders, the human redlines.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "redline": "./bin/redline.js"
