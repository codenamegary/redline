    "test": "bun test"
  },
  "dependencies": {
    "@redline/http-contracts": "workspace:*",
    "fastify": "^5.12.1",
    "typebox": "^1.3.25",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
