{
  "name": "redline-monorepo",
  "private": true,
  "version": "0.4.1",
  "description": "Local review server for AI-generated design artifacts. The agent renders, the human redlines.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun run --parallel --filter redline --filter @redline/ui dev",
    "dev:server": "bun run --filter redline dev",
    "dev:ui": "bun run --filter @redline/ui dev",
    "serve": "bun run --filter redline serve",
    "build:web": "bun run --filter @redline/ui build",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run lint && bun run typecheck && bun run test"
  }
}
